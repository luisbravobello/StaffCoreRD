@model IEnumerable<StaffCoreRD.Models.Staff>
@{
    ViewData["Title"] = "Personal";
}

<h2>Personal - StaffCore RD</h2>

@if (User.IsInRole("Administrador") || User.IsInRole("RRHH"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">+ Nuevo Empleado</a>
        <a asp-action="Estadisticas" class="btn btn-outline-secondary">Ver estadísticas por departamento</a>
    </p>
}

<div class="form-group mb-3">
    <label for="buscarInput">Buscar por nombre</label>
    <input type="text" id="buscarInput" class="form-control" placeholder="Escribe un nombre..." oninput="buscarPersonal()" />
</div>

<div id="resultados-personal">
    @await Html.PartialAsync("_TablaPersonal", Model)
</div>

@section Scripts {
    <script>
        let temporizador;
        function buscarPersonal() {
            clearTimeout(temporizador);
            temporizador = setTimeout(() => {
                const termino = document.getElementById('buscarInput').value;
                fetch('/Staff/Buscar?term=' + encodeURIComponent(termino))
                    .then(respuesta => respuesta.text())
                    .then(html => {
                        document.getElementById('resultados-personal').innerHTML = html;
                    });
            }, 250); // pequeño retraso para no disparar una peticion por cada tecla
        }
    </script>
}
