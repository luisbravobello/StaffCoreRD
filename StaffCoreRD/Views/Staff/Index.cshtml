@model IEnumerable<StaffCoreRD.Models.Staff>
@{
    ViewData["Title"] = "Personal";
}

<h2>Personal - StaffCore RD</h2>

@if (User.IsInRole("Administrador") || User.IsInRole("RRHH"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">+ Nuevo Empleado</a>
    </p>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.Nombre)</th>
            <th>@Html.DisplayNameFor(m => m.Cedula)</th>
            <th>@Html.DisplayNameFor(m => m.Cargo)</th>
            <th>@Html.DisplayNameFor(m => m.Departamento)</th>
            <th>@Html.DisplayNameFor(m => m.Salario)</th>
            <th>@Html.DisplayNameFor(m => m.Activo)</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nombre</td>
                <td>@item.Cedula</td>
                <td>@item.Cargo</td>
                <td>@item.Departamento</td>
                <td>@item.Salario.ToString("C")</td>
                <td>@(item.Activo ? "Sí" : "No")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-secondary">Ver</a>

                    @if (User.IsInRole("Administrador") || User.IsInRole("RRHH"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                    }

                    @if (User.IsInRole("Administrador"))
                    {
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
